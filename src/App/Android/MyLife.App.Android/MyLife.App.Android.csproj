<Project Sdk="Microsoft.NET.Sdk">
	
    <PropertyGroup>
	    <OutputType>Exe</OutputType>
	    <TargetFramework>net9.0-android</TargetFramework>
		
	    <ApplicationVersion>1</ApplicationVersion>
	    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
        <UseMaui>true</UseMaui>
        <SupportedOSPlatformVersion>34.0</SupportedOSPlatformVersion>
		<AndroidEnableMultiDex>True</AndroidEnableMultiDex>

		<AndroidUseSharedRuntime>False</AndroidUseSharedRuntime>
		<EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>

		<DefineConstants>$(DefineConstants);PLATFORM_MOBILE</DefineConstants>
    </PropertyGroup>
	
    
	
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <TrimMode>copyused</TrimMode>
        <AndroidLinkTool>r8</AndroidLinkTool>
        <PublishTrimmed>True</PublishTrimmed>
    </PropertyGroup>
	
    <ItemGroup>
        <None Remove="Icon.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.16" />
	    <PackageReference Include="Avalonia.Maui" Version="11.1.0" />
	    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.90" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyLife.App.Android.UI.Mobile\MyLife.App.Android.UI.Mobile.csproj" />
        <ProjectReference Include="..\MyLife.App.Android.UI.Watch\MyLife.App.Android.UI.Watch.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assets\plugins\" />
        <Folder Include="Services\Features\" />

        <AndroidAsset Include="Assets\plugins\**\*" />
    </ItemGroup>
</Project>
